# ── Virtual Environment ───────────────────────────────────────────────
# Never push your venv to GitHub — it's huge and machine-specific
pipeline_env/
venv/
env/
.env/
*.venv

# ── Python Cache ──────────────────────────────────────────────────────
# Auto-generated by Python, not needed in repo
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Pytest Cache ──────────────────────────────────────────────────────
.pytest_cache/
.cache/

# ── Pipeline Output Files ─────────────────────────────────────────────
# Local test outputs — no need to push cleaned CSVs to GitHub
local_test/output/

# ── Environment Variables / Secrets ───────────────────────────────────
# NEVER push AWS keys or secrets to GitHub
.env
.env.local
*.env
secrets.json
config.json

# ── AWS Credentials ───────────────────────────────────────────────────
.aws/
aws-credentials.json

# ── OS Generated Files ────────────────────────────────────────────────
# Windows
Thumbs.db
Desktop.ini

# Mac
.DS_Store
.AppleDouble

# ── IDE / Editor Files ────────────────────────────────────────────────
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ── Logs ──────────────────────────────────────────────────────────────
*.log
logs/

# ── Zip / Build Artifacts ─────────────────────────────────────────────
*.zip
*.tar.gz
dist/
build/
